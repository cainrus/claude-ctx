{
  "name": "claude-ctx",
  "version": "0.10.0",
  "private": true,
  "description": "Claude Code session context from one plugin: prompt-cache keep-alive and a status line from the engine's own figures.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sergei Tarassov <cainrus@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cainrus/claude-ctx.git"
  },
  "homepage": "https://github.com/cainrus/claude-ctx#readme",
  "bugs": "https://github.com/cainrus/claude-ctx/issues",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "workspace/*"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.ts' 'workspace/*/test/*.test.ts'",
    "hooks": "node scripts/hooks.ts",
    "docs": "node workspace/cache-keeper/scripts/docs.ts"
  }
